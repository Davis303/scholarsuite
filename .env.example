# ============================================================
# ScholarSuite — environment variables
#
# Copy this file to `.env.local` for local development, or paste the
# values into your Vercel project (Settings → Environment Variables).
#
# LEGEND:
#   [PUBLIC]  — safe to expose in the browser (NEXT_PUBLIC_*)
#   [SECRET]  — server-only. NEVER commit, never put in client code.
# ============================================================

# --- Supabase ------------------------------------------------
# [PUBLIC] Your Supabase project's API URL.
# Find it at: Supabase Dashboard → your project → Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# [PUBLIC] Your Supabase project's public "anon" API key.
# Find it at: Supabase Dashboard → your project → Settings → API → "anon public"
# This key is safe to expose: Row-Level Security protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SECRET] Your Supabase "service_role" key.
# Find it at: Supabase Dashboard → your project → Settings → API → "service_role"
# WARNING: this key bypasses all database security rules. It lives only on the
# server and must never be shipped to the browser or committed to git.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI features (optional) ----------------------------------
# [SECRET] API key for an OpenAI-compatible LLM provider. Used ONLY by the
# Writing Assistant and Deep Proofread AI features. Everything else —
# similarity review, highlighting, exports — works without it.
# Get one from a provider (e.g. openai.com → API keys) and add billing/credit there.
LLM_API_KEY=

# [PUBLIC not needed — server only] Which model the AI writing features use.
# Optional; sensible default is built in. Example: gpt-4o-mini
LLM_MODEL=

# [SECRET-ish — server only] Custom API base URL if you use a provider other
# than OpenAI. Optional; defaults to https://api.openai.com/v1
LLM_BASE_URL=

# --- App -----------------------------------------------------
# [PUBLIC] The brand name shown across the UI. Rename your app by changing
# this value (plus the logo/favicon files in public/ — see README).
NEXT_PUBLIC_APP_NAME=ScholarSuite

# [PUBLIC] The public URL of your deployed app, e.g.
# https://your-app-name.vercel.app
# Used to build the email verification links. After you deploy, set this to
# the live URL and redeploy.
NEXT_PUBLIC_APP_URL=

# [PUBLIC not needed — server only] Maximum upload size in megabytes.
# Optional; defaults to 25 if unset.
MAX_UPLOAD_MB=25

# --- Scheduled cleanup (optional) ----------------------------
# [SECRET] A random password-like string you invent (e.g. 32 random characters).
# It guards the /api/cron/cleanup endpoint so only your Vercel Cron job can
# trigger automatic data deletion. Required only if you enable the cron job.
CRON_SECRET=
